{
    "name": "angular-template",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build --prod",
        "test": "jest",
        "lint": "ng lint",
        "test:watch": "jest --watch"
    },
    "private": true,
    "dependencies": {
        "@angular-devkit/core": "^11.2.1",
        "@angular-devkit/schematics": "^11.2.1",
        "@angular/animations": "^12.0.5",
        "@angular/cdk": "^11.2.1",
        "@angular/common": "^11.2.1",
        "@angular/compiler": "^11.2.1",
        "@angular/core": "^11.2.1",
        "@angular/forms": "^11.2.1",
        "@angular/localize": "^11.2.1",
        "@angular/material": "^11.2.1",
        "@angular/platform-browser": "^11.2.1",
        "@angular/platform-browser-dynamic": "^11.2.1",
        "@angular/router": "^11.2.1",
        "@briebug/jest-schematic": "^3.1.0",
        "@circlon/angular-tree-component": "^11.0.3",
        "@fortawesome/fontawesome-free": "^5.13.0",
        "@ng-bootstrap/ng-bootstrap": "^9.1.3",
        "@schematics/angular": "^11.2.1",
        "@tinymce/tinymce-angular": "^4.2.2",
        "@types/jquery": "^3.5.1",
        "ag-grid-angular": "^25.1.0",
        "ag-grid-community": "^25.1.0",
        "ajv": "^7.1.1",
        "angular-split": "^5.0.0",
        "angular7-csv": "^0.2.12",
        "bootstrap": "^4.4.1",
        "core-js": "^3.6.5",
        "font-awesome": "^4.7.0",
        "guid-typescript": "^1.0.9",
        "jquery": "^3.5.1",
        "moment": "^2.29.1",
        "ngx-form-error": "^1.1.3",
        "ngx-toastr": "^13.2.1",
        "popper.js": "^1.16.1",
        "rxjs": "^7.0.0",
        "tinymce": "^5.7.1",
        "tslib": "^2.0.0",
        "zone.js": "^0.11.4"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "~0.1102.1",
        "@angular/cli": "~11.2.1",
        "@angular/compiler-cli": "^11.2.1",
        "@angular/language-service": "^11.2.1",
        "@types/jasmine": "~3.6.0",
        "@types/jasminewd2": "~2.0.8",
        "@types/jest": "^26.0.20",
        "@types/node": "^14.14.28",
        "codelyzer": "^6.0.0",
        "jasmine-core": "~3.6.0",
        "jasmine-spec-reporter": "^6.0.0",
        "jest": "^26.6.3",
        "jest-preset-angular": "^8.3.2",
        "protractor": "~7.0.0",
        "stylelint": "^13.7.0",
        "ts-node": "^9.1.1",
        "tslint": "~6.1.0",
        "typescript": "^4.1.5"
    },
    "jest": {
        "preset": "jest-preset-angular",
        "roots": [
            "src"
        ],
        "transform": {
            "^.+\\.(ts|js|html)$": "ts-jest"
        },
        "setupFilesAfterEnv": [
            "<rootDir>/src/setupJest.ts"
        ],
        "moduleNameMapper": {
            "@app/(.*)": "<rootDir>/src/app/$1",
            "@assets/(.*)": "<rootDir>/src/assets/$1",
            "@core/(.*)": "<rootDir>/src/app/core/$1",
            "@env": "<rootDir>/src/environments/environment",
            "@src/(.*)": "<rootDir>/src/src/$1",
            "@state/(.*)": "<rootDir>/src/app/state/$1"
        },
        "globals": {
            "ts-jest": {
                "tsConfig": "<rootDir>/src/tsconfig.spec.json",
                "stringifyContentPathRegex": "\\.html$",
                "astTransformers": [
                    "jest-preset-angular/build/InlineFilesTransformer",
                    "jest-preset-angular/build/StripStylesTransformer"
                ]
            }
        },
        "prettier": {
            "singleQuote": true,
            "proseWrap": "never"
        }
    }
}
